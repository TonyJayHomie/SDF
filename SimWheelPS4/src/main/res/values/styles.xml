<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Holo.NoActionBar">
        <item name="android:colorPrimary">#1a1a2e</item>
        <item name="android:colorPrimaryDark">#0f0f1a</item>
        <item name="android:colorAccent">#e94560</item>
        <item name="android:windowBackground">#1a1a2e</item>
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:background">#e94560</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LabelStyle">
        <item name="android:textColor">#aaaacc</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ValueStyle">
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
