<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status bar -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="#16213e"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:gravity="center"
            android:text="@string/status_idle" />

        <!-- Controller status -->
        <TextView
            android:id="@+id/tv_controller_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:gravity="center"
            android:text="@string/no_controller" />

        <!-- Steering wheel canvas -->
        <com.simwheel.ps4.ui.SteeringWheelView
            android:id="@+id/steering_wheel"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Steering value -->
        <TextView
            android:id="@+id/tv_steering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/steering_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Steering: 0.0°" />

        <!-- Throttle row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="@color/throttle_color"
                android:textSize="13sp"
                android:text="THROTTLE" />

            <com.simwheel.ps4.ui.BarView
                android:id="@+id/bar_throttle"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_throttle"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textColor="@color/throttle_color"
                android:textSize="13sp"
                android:gravity="end"
                android:text="0%" />
        </LinearLayout>

        <!-- Brake row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="@color/brake_color"
                android:textSize="13sp"
                android:text="BRAKE" />

            <com.simwheel.ps4.ui.BarView
                android:id="@+id/bar_brake"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_brake"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:textColor="@color/brake_color"
                android:textSize="13sp"
                android:gravity="end"
                android:text="0%" />
        </LinearLayout>

        <!-- IP input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_ip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/ip_hint"
                android:inputType="textUri"
                android:textColor="@color/white"
                android:textColorHint="@color/grey"
                android:background="#16213e"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ButtonStyle"
                android:text="@string/connect" />
        </LinearLayout>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_recenter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                style="@style/ButtonStyle"
                android:background="#16213e"
                android:text="Re-center" />

            <Button
                android:id="@+id/btn_calibrate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                style="@style/ButtonStyle"
                android:text="@string/calibrate" />

            <Button
                android:id="@+id/btn_mapping"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="@style/ButtonStyle"
                android:text="@string/mapping" />
        </LinearLayout>

        <!-- Vibration toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:background="#16213e"
            android:padding="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="Vibration Feedback" />

            <Switch
                android:id="@+id/sw_vibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Vibration intensity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:background="#16213e"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/grey"
                android:textSize="12sp"
                android:text="Vibration Intensity: " />

            <SeekBar
                android:id="@+id/sb_vibration_intensity"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:progress="80"
                android:max="100" />

            <TextView
                android:id="@+id/tv_vib_intensity"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="end"
                android:text="80%" />
        </LinearLayout>

        <!-- Live button display -->
        <TextView
            android:id="@+id/tv_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#16213e"
            android:padding="10dp"
            android:textColor="@color/grey"
            android:textSize="11sp"
            android:text="Buttons: —" />

    </LinearLayout>
</ScrollView>
