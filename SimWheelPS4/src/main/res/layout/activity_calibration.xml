<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Calibration"
            android:layout_marginBottom="16dp" />

        <!-- Live steering preview -->
        <com.simwheel.ps4.ui.SteeringWheelView
            android:id="@+id/steering_preview"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_calib_steering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/steering_color"
            android:textSize="16sp"
            android:text="Steering: 0.0°"
            android:layout_marginBottom="20dp" />

        <!-- Steering Range -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/grey" android:textSize="12sp" android:text="Steering Range (90–2520°)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/sb_range" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="2430" android:progress="810" />
            <TextView android:id="@+id/tv_range" android:layout_width="60dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:gravity="end" android:text="900°" />
        </LinearLayout>

        <!-- Gyro Sensitivity -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/grey" android:textSize="12sp" android:text="Gyro Sensitivity"
            android:layout_marginTop="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/sb_sensitivity" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="300" android:progress="100" />
            <TextView android:id="@+id/tv_sensitivity" android:layout_width="60dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:gravity="end" android:text="1.00x" />
        </LinearLayout>

        <!-- Gyro Filter -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/grey" android:textSize="12sp" android:text="Gyro Smoothing (0=raw, 99=max smooth)"
            android:layout_marginTop="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/sb_filter" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="99" android:progress="80" />
            <TextView android:id="@+id/tv_filter" android:layout_width="60dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:gravity="end" android:text="80" />
        </LinearLayout>

        <!-- Trigger dead zone -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/grey" android:textSize="12sp" android:text="Trigger Dead Zone (%)"
            android:layout_marginTop="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/sb_deadzone" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:max="30" android:progress="2" />
            <TextView android:id="@+id/tv_deadzone" android:layout_width="60dp" android:layout_height="wrap_content"
                android:textColor="@color/white" android:gravity="end" android:text="2%" />
        </LinearLayout>

        <!-- Live trigger preview -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/grey" android:textSize="12sp" android:text="Live Trigger Test"
            android:layout_marginTop="20dp" android:layout_marginBottom="4dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="60dp" android:layout_height="wrap_content"
                android:textColor="@color/throttle_color" android:textSize="12sp" android:text="RT" />
            <com.simwheel.ps4.ui.BarView android:id="@+id/bar_calib_throttle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="24dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tv_calib_throttle"
                android:layout_width="48dp" android:layout_height="wrap_content"
                android:textColor="@color/throttle_color" android:textSize="12sp" android:gravity="end" android:text="0%" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
            <TextView android:layout_width="60dp" android:layout_height="wrap_content"
                android:textColor="@color/brake_color" android:textSize="12sp" android:text="LT" />
            <com.simwheel.ps4.ui.BarView android:id="@+id/bar_calib_brake"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="24dp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/tv_calib_brake"
                android:layout_width="48dp" android:layout_height="wrap_content"
                android:textColor="@color/brake_color" android:textSize="12sp" android:gravity="end" android:text="0%" />
        </LinearLayout>

        <Button android:id="@+id/btn_save_calib"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/ButtonStyle"
            android:text="Save Calibration" />

        <Button android:id="@+id/btn_back_calib"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/ButtonStyle"
            android:background="#16213e"
            android:text="Back" />

    </LinearLayout>
</ScrollView>
