<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calibration" />

        <TextView style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tilt the phone / spin the wheel / pull triggers. Tune sliders to match how you want it to feel."
            android:layout_marginTop="2dp" />

        <!-- Live steering visualization -->
        <LinearLayout style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live steering" />

            <com.sdf.simwheelps4.WheelView
                android:id="@+id/wheel"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/val_steer_deg"
                style="@style/MonoLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0.0°" />

            <!-- Steering Range (matches receiver userRange exactly) -->
            <TextView
                android:id="@+id/lbl_range_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Steering range: 900°  (must match PC receiver's userRange)"
                android:layout_marginTop="12dp" />
            <SeekBar
                android:id="@+id/seek_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="2430"
                android:progress="810" />

            <!-- Gyro Sensitivity 0..5 default 1   (matches original "gyro_sensitivity") -->
            <TextView
                android:id="@+id/lbl_sens_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gyro Sensitivity: 1.0  (Default 1, higher = more sensitive, max 5)"
                android:layout_marginTop="8dp" />
            <SeekBar
                android:id="@+id/seek_sens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="10" />

            <!-- Gyro Anti-Shake 0..99 default 80 (matches original "gyro_filter") -->
            <TextView
                android:id="@+id/lbl_antishake_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gyro Anti-Shake: 80  (0 = no filter, 99 = max smooth)" />
            <SeekBar
                android:id="@+id/seek_antishake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="99"
                android:progress="80" />

            <!-- Steering auto rotating to center in sec (0-10) -->
            <TextView
                android:id="@+id/lbl_center_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Steering center duration: off  (auto-return to center in seconds, 0 = off)" />
            <SeekBar
                android:id="@+id/seek_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0" />

            <CheckBox
                android:id="@+id/chk_invert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Invert steering direction (Configure Axis Mode)" />

            <CheckBox
                android:id="@+id/chk_show_angle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Show steering angle (numeric readout)" />

            <Button
                android:id="@+id/btn_center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Center steering here" />
        </LinearLayout>

        <!-- Trigger visualization -->
        <LinearLayout style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Throttle &amp; Brake Input" />

            <TextView style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L2 — Brake"
                android:layout_marginTop="8dp" />
            <ProgressBar
                android:id="@+id/bar_l2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="1000" />

            <TextView style="@style/Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R2 — Throttle"
                android:layout_marginTop="8dp" />
            <ProgressBar
                android:id="@+id/bar_r2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:max="1000" />

            <TextView
                android:id="@+id/lbl_trig_min_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trigger deadzone (min): 0.00"
                android:layout_marginTop="12dp" />
            <SeekBar
                android:id="@+id/seek_trig_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="500"
                android:progress="0" />

            <TextView
                android:id="@+id/lbl_trig_max_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trigger saturation (max): 1.00" />
            <SeekBar
                android:id="@+id/seek_trig_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="1000" />

            <TextView
                android:id="@+id/lbl_trig_curve_val"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trigger response curve: 1.00" />
            <SeekBar
                android:id="@+id/seek_trig_curve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="100" />

            <CheckBox
                android:id="@+id/chk_invert_throttle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Invert throttle" />

            <CheckBox
                android:id="@+id/chk_invert_brake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Invert brake" />
        </LinearLayout>

        <!-- Clutch (optional) -->
        <LinearLayout style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/chk_clutch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:text="Enable Clutch Slider (sends \&quot;clutch \&quot; axis to receiver)" />

            <TextView style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When enabled, the slider on the main screen sends clutch values to the PC (vJoy RX axis)." />
        </LinearLayout>

        <Button
            android:id="@+id/btn_reset_calib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Reset to defaults" />

    </LinearLayout>
</ScrollView>
