<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="Card">
        <item name="android:background">@color/card</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="H1">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="H2">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_dim</item>
    </style>

    <style name="MonoLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="PrimaryButton" parent="android:Widget.Material.Button">
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
